# =============================================================================
# Puente WhatsApp <-> ChatJUCHLM (probe "prueba sin romper")
# ---------------------------------------------------------------------------
# Este archivo NO forma parte del sistema web: vive solo en integrations/.
# No contiene secretos reales: copiarlo a .env y rellenar los valores.
# El .env del puente NO se sube a git (integrations/ entera está gitignoreada).
# =============================================================================

# Secreto HMAC compartido con el webhook registrado en OpenWA (>= 16 caracteres).
# Genéralo tú: python -c "import secrets;print(secrets.token_hex(24))"
WEBHOOK_SECRET=cambia-este-secreto-largo

# API key ADMIN (o operator con scope de sesion) que OpenWA imprime en su primer
# arranque y guarda en integrations/OpenWA/data/.api-key
OPENWA_API_KEY=
OPENWA_URL=http://127.0.0.1:2785
OPENWA_SESSION=juchlm-probe

# Sistema web ChatJUCHLM (NO se modifica; solo se le habla por HTTP)
JC_URL=http://127.0.0.1:8000

# Puerto local del puente (webhook receiver)
BRIDGE_PORT=2786

# Grupos: por defecto el puente solo atiende chats 1:1 (probe seguro)
ALLOW_GROUPS=false
# Mensaje rapido de confirmacion mientras FSM/RAG piensa (true|false)
SEND_ACK=true
# Prefijo obligatorio? Si se define, solo los mensajes que empiecen con este prefijo
# se atienden (ej. "/juchlm"). Vacio = responder todo.
MESSAGE_PREFIX=
